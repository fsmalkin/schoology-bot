TELEGRAM_BOT_TOKEN="paste_beta_bot_token_here"
TELEGRAM_CHAT_IDS="-1234567890"
# Optional Telegram forum topic/thread id for scheduled outbound messages.
TELEGRAM_MESSAGE_THREAD_ID=""
DATA_DIR="data/beta"
AGENT_DB_PATH="data/beta/agent.runtime.db"
STATE_PATH="data/beta/state.json"
OPENAI_API_KEY="your_openai_key"
OPENAI_MODEL="gpt-5.2"
OPENAI_REASONING_EFFORT="high"
OPENAI_MAX_OUTPUT_TOKENS="2000"
OPENAI_CAPABILITY_GUARD="true"
LOGIN_ALERTS_ENABLED="true"
LOGIN_ALERT_COOLDOWN_MINUTES="360"
SCHOLOGY_LOGIN_ATTEMPTS="2"
SCHOLOGY_LOGIN_RETRY_DELAY_MS="1500"
LOGIN_DIAGNOSTIC_PATH="data/beta/login-diagnostic.json"
TIMEZONE="America/New_York"
SCRAPE_CRON="0 6 * * *"
SEND_CRON="0 7 * * *"
REMINDER_CRON="*/1 * * * *"
LIVE_CHECK_ENABLED="false"
LIVE_CHECK_CRON="0 5 * * *"
LIVE_CHECK_CHAT_IDS=""

# Auto-ignore filters (optional)
AUTO_IGNORE_ENABLED="true"
AUTO_IGNORE_OLD_DAYS="120"
AUTO_IGNORE_KEYWORDS="practice,not for grade,non-graded,participation,optional"

# Auto-upcoming reminders (optional)
AUTO_UPCOMING_ENABLED="true"
AUTO_UPCOMING_DAYS="7"
AUTO_UPCOMING_REMIND_HOUR="16"
AUTO_UPCOMING_REMIND_MINUTE="0"
