SCHOLOGY_USERNAME="mayari.student@example.com"
SCHOLOGY_PASSWORD="example-password-123"
# Optional: load credentials from files instead of plain env values.
SCHOLOGY_USERNAME_FILE=""
SCHOLOGY_PASSWORD_FILE=""
SCHOLOGY_IDP="microsoft"
SCHOLOGY_SSO_SCHOOL="Baltimore County Public Schools"
SCHOLOGY_LOGIN_URL=https://bcps.schoology.com/login
SCHOLOGY_GRADES_URL=https://bcps.schoology.com/grades/grades
# Optional: bootstrap Playwright session state from secrets for unattended runs.
STORAGE_STATE_B64=""
STORAGE_STATE_B64_FILE=""
STORAGE_STATE_ENC_B64=""
STORAGE_STATE_ENC_B64_FILE=""
STORAGE_STATE_ENC_KEY=""
STUDENT_NAME="Mayari Smalkin"
TIMEZONE=America/New_York
SCRAPE_CRON="0 6 * * *"
SEND_CRON="0 7 * * *"
REMINDER_CRON="*/1 * * * *"
LIVE_CHECK_ENABLED=false
LIVE_CHECK_CRON="0 5 * * *"
LIVE_CHECK_CHAT_IDS="123456789"
DASHBOARD_PORT=8787
SCRAPE_DETAIL_FALLBACK_ENABLED=true
SCRAPE_DETAIL_FALLBACK_MAX=12
DELIVERY_CHANNEL="telegram"
TELEGRAM_BOT_TOKEN="123456789:example-telegram-bot-token"
TELEGRAM_CHAT_IDS="123456789"
OPENAI_API_KEY="sk-example"
OPENAI_MODEL="gpt-5.2"
OPENAI_REASONING_EFFORT="high"
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_CAPABILITY_GUARD=true
OPENAI_DB_MEMORY_ENABLED=true

# Auto-ignore filters (optional)
AUTO_IGNORE_ENABLED=true
AUTO_IGNORE_OLD_DAYS=120
AUTO_IGNORE_KEYWORDS=practice,not for grade,non-graded,participation,optional

# Auto-upcoming reminders (optional)
AUTO_UPCOMING_ENABLED=true
AUTO_UPCOMING_DAYS=7
AUTO_UPCOMING_REMIND_HOUR=16
AUTO_UPCOMING_REMIND_MINUTE=0
AUTO_CANCEL_RESOLVED_ASSIGNMENT_REMINDERS=true
OPENAI_COMPACT_AFTER_TURNS=20
AGENT_LOG_PATH="data/agent.log"
AGENT_DB_PATH="data/agent.db"
# Optional: enable with `docker compose --profile tailscale up -d --build`
TAILSCALE_AUTH_KEY=""
TAILSCALE_DASHBOARD_HOSTNAME="schoology-dashboard"
GITHUB_REPO="yourname/schoology-bot"
GITHUB_TOKEN="ghp_exampletoken"
GITHUB_LABELS="bug,agent"
DEBUG_DUMP=false
