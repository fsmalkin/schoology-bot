{
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "conciseReply", "observedAt", "sourceTabId", "resolvedAssignment", "sourceSnapshot"],
  "properties": {
    "state": { "type": "string", "enum": ["ok", "unavailable"] },
    "conciseReply": { "type": "string", "minLength": 1, "maxLength": 3500 },
    "observedAt": { "type": ["string", "null"] },
    "sourceTabId": { "type": ["string", "null"] },
    "sourceSnapshot": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["profileId", "term", "assignments"],
          "properties": {
            "profileId": { "type": "string" },
            "term": { "type": "string" },
            "assignments": {
              "type": "array", "minItems": 1, "maxItems": 1000,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["url", "course", "title"],
                "properties": {
                  "url": { "type": "string" },
                  "course": { "type": "string" },
                  "title": { "type": "string" }
                }
              }
            }
          }
        }
      ]
    },
    "resolvedAssignment": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["url", "course", "title"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://bcps\\.schoology\\.com/assignment/[1-9][0-9]*$" },
            "course": { "type": "string", "minLength": 1, "maxLength": 500 },
            "title": { "type": "string", "minLength": 1, "maxLength": 500 }
          }
        }
      ]
    }
  }
}
