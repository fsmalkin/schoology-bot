{
  "name": "schoology-missing-assignments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "scrape": "node src/run.js scrape",
    "send": "node src/run.js send",
    "run-once": "node src/run.js once",
    "start": "node src/scheduler.js",
    "telegram:updates": "node src/telegram_updates.js",
    "telegram:updates:beta": "node scripts/with_env.js .env.beta node -r dotenv/config src/telegram_updates.js",
    "login:interactive": "node src/interactive_login.js",
    "login:interactive:beta": "node scripts/with_env.js .env.beta node -r dotenv/config src/interactive_login.js",
    "openai:smoke": "node src/openai_smoke.js",
    "agent:telegram": "node src/telegram_agent.js",
    "agent:cli": "node src/agent_cli.js",
    "dashboard": "node src/dashboard.js",
    "openclaw:api": "node src/openclaw_tool_api.js",
    "reminders:cleanup": "node src/reminder_cleanup.js",
    "beta:reset-memory": "powershell -ExecutionPolicy Bypass -File scripts/reset_beta_from_prod_memory.ps1",
    "stories:run": "node scripts/run_agentic_story_suite.mjs",
    "stories:judge": "node scripts/judge_agentic_story_suite.mjs",
    "stories:gate": "npm run stories:run && npm run stories:judge",
    "managed:render-agent:dev": "node scripts/managed_agents_admin.mjs render-agent dev",
    "managed:render-env:dev": "node scripts/managed_agents_admin.mjs render-environment dev",
    "managed:create-env:dev": "node scripts/with_env.js .env.managed-dev node -r dotenv/config scripts/managed_agents_admin.mjs create-environment dev",
    "managed:create-agent:dev": "node scripts/with_env.js .env.managed-dev node -r dotenv/config scripts/managed_agents_admin.mjs create-agent dev",
    "test": "node --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "test:agent": "node tests/agent_conversation.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chrono-node": "^2.9.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^6.9.14",
    "openai": "^4.81.0",
    "playwright": "^1.49.0",
    "twilio": "^5.12.0"
  }
}
